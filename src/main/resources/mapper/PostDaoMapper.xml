	<select id="getList" resultType="com.yjproject.web.entity.Post">
		<!-- SELECT * FROM POST WHERE WRITER=1 ORDER BY REGDATE DESC -->
		SELECT * FROM ( 
		SELECT ROWNUM NUM, P.* FROM 
		(SELECT * FROM POST WHERE OWNER=#{owner} ORDER BY REGDATE DESC) P 
		WHERE TITLE LIKE '%${keyword}%' OR CONTENTS LIKE '%${keyword}%') 
		WHERE NUM BETWEEN #{start} AND #{end}
		<!-- SELECT * FROM (
		SELECT ROWNUM NUM, B.* FROM 
		(SELECT * FROM BOARDVIEW ORDER BY REGDATE DESC) B 
		WHERE ${field} LIKE '%${query}%') 
		WHERE NUM BETWEEN #{start} AND #{end} -->
	</select>
	<select id="postCount" resultType="Integer">
		SELECT COUNT(IDX) COUNT FROM POST WHERE OWNER=#{owner} AND (TITLE LIKE '%${keyword}%' OR CONTENTS LIKE '%${keyword}%')
	</select>
	<select id="getUserIdx" resultType="Integer">
		SELECT IDX FROM USERS WHERE BLOG=#{blog}
	</select>
	<select id="getPost" resultType="com.yjproject.web.entity.Post">
		SELECT * FROM POST WHERE IDX=#{postIdx}
	</select>
	<delete id="delPost">
		DELETE POST WHERE IDX=#{postIdx}
	</delete>
	<insert id="setPost">
		INSERT INTO POST VALUES(POST_SEQ.NEXTVAL, #{owner}, #{category}, #{title}, #{contents}, #{thumbnail}, #{description}, #{files}, SYSDATE)
	</insert>
